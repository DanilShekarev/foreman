# Настройки Foreman. Скопируйте в .env и правьте под себя — .env в .gitignore.
# Значения из окружения приоритетнее файла. Всё ниже необязательно: без .env
# сервер поднимется на 127.0.0.1:8010 с базой и волтом рядом с server.py.

# --- Сервер ---------------------------------------------------------------
# 0.0.0.0 — доступ по локальной сети. Держите 127.0.0.1, пока не понимаете,
# кто увидит порт: авторизация есть, но инструмент не рассчитан на публичный
# интернет без обратного прокси с HTTPS.
GD_HOST=127.0.0.1
GD_PORT=8010
# Префикс за обратным прокси (Caddy/nginx: example.com/foreman). Пусто — корень.
GD_WEB_BASE=
# Пароль админа при ПЕРВОМ запуске. Пусто — случайный, печатается в консоль.
GD_ADMIN_PASSWORD=
# Лимит размера вложения, МБ.
GD_MAX_UPLOAD_MB=50

# --- Данные ---------------------------------------------------------------
# База SQLite и корень базы знаний. По умолчанию data/gd.sqlite и vault/.
GD_DB=
GD_VAULT=

# --- Агент ----------------------------------------------------------------
# Провайдеры и модели настраиваются в UI: админ → «Модели агента». Ключ можно
# не хранить в базе: в поле ключа написать env:ИМЯ_ПЕРЕМЕННОЙ, например
# env:OPENROUTER_API_KEY, и положить сам ключ сюда.
# OPENROUTER_API_KEY=
#
# Модель по умолчанию и стартовый список для провайдера Claude (только при
# первом запуске, дальше правится в UI).
GD_MODEL=sonnet
GD_MODELS=sonnet,opus,haiku
# Токен подписки Claude (`claude setup-token`). Пусто — ищется auth_token.txt
# рядом с server.py. Нужен только движку claude; для OpenAI-совместимых
# провайдеров не требуется.
GD_CLAUDE_TOKEN_FILE=
# Потолок ходов агента за один запрос.
GD_MAX_TURNS=100
# Сколько символов ленты чата класть в контекст хода.
GD_CONTEXT_CHARS=16000
# Бюджет истории для своего цикла (OpenAI-совместимые провайдеры), символов.
GD_HISTORY_CHARS=120000
# Таймаут запроса к LLM, секунды.
GD_LLM_TIMEOUT=600

# --- Зеркало кодовой базы -------------------------------------------------
# Путь к git-репозиторию проекта, который агент читает (только чтение).
# ПУСТО — кодовой базы у агента нет вовсе, остаются чаты и база знаний.
# Агент читает не эту рабочую копию, а её зеркало: только закоммиченное,
# без чужих веток и незавершённых правок.
GD_CODE_REPO=
# Какие каталоги выкачивать в зеркало, через «;». Пусто — репозиторий целиком.
# Для крупных репозиториев ограничьте: зеркало качается с --filter=blob:none.
GD_CODE_PATHS=
# Ветка-источник и период синхронизации (минуты).
GD_CODE_BRANCH=main
GD_MIRROR_SYNC_MIN=10
# Куда класть зеркало. По умолчанию data/code-mirror.
GD_CODE_MIRROR=
#
# ВАЖНО: партиальный клон требует в ИСХОДНОМ репозитории двух локальных опций,
# иначе .git зеркала распухнет до полного снапшота:
#   git config uploadpack.allowFilter true
#   git config uploadpack.allowAnySHA1InWant true

# --- Бэкапы ---------------------------------------------------------------
# Автобэкап раз в N часов (0 — выключить): база (онлайн-копия SQLite),
# волт (git bundle), вложения и записи звонков (докопирование новых).
# Первый прогон — через 10 минут после старта. Ручной запуск: tools/backup.py.
GD_BACKUP_HOURS=24
# Куда складывать. По умолчанию data/backups — это защита от кривого
# обновления, но не от смерти диска: лучше указать другой физический диск
# или папку, которую синхронизирует облако.
GD_BACKUP_DIR=
# Сколько последних копий базы и волта хранить.
GD_BACKUP_KEEP=30

# --- Созвоны --------------------------------------------------------------
# Без TURN звонки работают только при прямой видимости (LAN, простые NAT).
# Для удалённых участников поднимите coturn и заполните три поля.
GD_STUN_URL=
GD_TURN_URL=
GD_TURN_USER=
GD_TURN_PASS=
# Либо полный ICE-конфиг одной JSON-строкой (перекрывает поля выше).
GD_ICE_JSON=

# --- Расшифровка созвонов -------------------------------------------------
# Каталог внешнего ASR-пайплайна (свой venv + модель). Пусто или нет каталога —
# расшифровка тихо выключена, звонки работают как обычно.
GD_TRANSCRIBE_DIR=
